# NextWatch Environment Configuration

# TMDB API (Get your free key from https://www.themoviedb.org/settings/api)
VITE_TMDB_API_KEY=your_tmdb_api_key_here
# Optional: If you prefer using TMDB Read Access Bearer Token (v4)
# VITE_TMDB_ACCESS_TOKEN=your_v4_read_access_token_here

# Firebase Configuration (Create a project at https://console.firebase.google.com/)
# 1. Enable Authentication -> Google Provider
# 2. Enable Cloud Firestore Database (in production or test mode)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Base path for GitHub Pages deployment (defaults to '/NextWatch/')
# VITE_BASE_PATH=/NextWatch/
